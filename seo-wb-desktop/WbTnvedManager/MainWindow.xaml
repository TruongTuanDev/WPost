<Window x:Class="WbTnvedManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WbTnvedManager.ViewModels"
        xmlns:views="clr-namespace:WbTnvedManager.Views"
        mc:Ignorable="d"
        Title="WPost - Wildberries TNVED Matrix &amp; Bulk Fix Manager (.NET 8)"
        Height="840" Width="1300"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Nav Button Style -->
        <Style x:Key="NavTabStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,16,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,14,24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,0">
                    <Border Background="#2563EB" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="WB" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WPOST • TNVED &amp; GENDER FIX PRO" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Kế thừa Logic &amp; Ma trận phân loại Wildberries" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Navigation Tabs (ListBox as Tab Switcher) -->
                <ListBox Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ItemContainerStyle="{StaticResource NavTabStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="📋 Hỗ Trợ Đăng Bài"/>
                    <ListBoxItem Content="🔍 Quét &amp; Sửa Lỗi Hàng Loạt"/>
                    <ListBoxItem Content="🗄️ Quản Lý Ma Trận TNVED"/>
                    <ListBoxItem Content="⚙️ Cài Đặt Hệ Thống"/>
                </ListBox>

                <!-- Status & Auto-Update Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Version Badge -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion, Mode=OneWay}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto Update Button -->
                    <Button Command="{Binding CheckOrApplyUpdateCommand}" 
                            Padding="12,6" 
                            FontSize="12" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#475569"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding UpdateButtonText, Mode=OneWay}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Tab Control (Headerless container bound to SelectedTabIndex) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Tab 0: Card Builder -->
            <TabItem>
                <views:CardBuilderView DataContext="{Binding CardBuilderVM}"/>
            </TabItem>

            <!-- Tab 1: Bulk Audit & Fix -->
            <TabItem>
                <views:BulkAuditView DataContext="{Binding BulkAuditVM}"/>
            </TabItem>

            <!-- Tab 2: Matrix Manager -->
            <TabItem>
                <views:MatrixManagerView DataContext="{Binding MatrixManagerVM}"/>
            </TabItem>

            <!-- Tab 3: Settings -->
            <TabItem>
                <views:SettingsView DataContext="{Binding SettingsVM}"/>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🟢 Cơ sở dữ liệu SQLite: tnved_matrix.db | Thuật toán FashionTnvedSelector sẵn sàng." Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Wildberries Content API v2 Integration | Rate Limit Safe (350ms)" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
