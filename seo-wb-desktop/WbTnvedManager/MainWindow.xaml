<Window x:Class="WbTnvedManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WbTnvedManager.ViewModels"
        xmlns:views="clr-namespace:WbTnvedManager.Views"
        mc:Ignorable="d"
        Title="WPost - Wildberries TNVED Matrix &amp; Bulk Fix Manager (.NET 8)"
        Height="860" Width="1340"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Sidebar Nav Item Style matching uploaded UI -->
        <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="itemBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="itemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="270"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <!-- Logo & Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Version & Update Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Brand Logo Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="WB" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WPOST" Foreground="#0F172A" FontWeight="Bold" FontSize="17"/>
                            <TextBlock Text="TNVED Matrix &amp; Bulk Fix" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,16,0,0" Background="#F1F5F9"/>
                </StackPanel>

                <!-- 2. Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="SidebarNavItemStyle"/>
                        </ListBox.ItemContainerStyle>

                        <!-- Nav 0: Hỗ Trợ Đăng Bài -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📋" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Hỗ trợ đăng bài" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </ListBoxItem>

                        <!-- Nav 1: Quét & Sửa Lỗi Hàng Loạt -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Quét &amp; sửa lỗi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                
                                <!-- Dynamic Badge (Shows items needing fix) -->
                                <Border Grid.Column="2" Background="#EF4444" CornerRadius="10" Padding="7,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BulkAuditVM.NeedsFixCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <!-- Nav 2: Quản Lý Ma Trận TNVED -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🗄️" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Ma trận TNVED" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </ListBoxItem>

                        <!-- Nav 3: Cài Đặt Hệ Thống -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚙️" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Cài đặt" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </ScrollViewer>

                <!-- 3. Bottom Version Badge & Auto-Update -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Version Tag & DB Status -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="SQLite Ready" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EEF2F6" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding AppVersion, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </Grid>

                        <!-- Auto Update Button -->
                        <Button Command="{Binding CheckOrApplyUpdateCommand}" 
                                Padding="10,8" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                Cursor="Hand"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                            <Setter Property="Background" Value="#16A34A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding UpdateButtonText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= RIGHT MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <!-- Headerless TabControl hosting views, switched by SelectedTabIndex -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Tab 0: Card Builder -->
                <TabItem>
                    <views:CardBuilderView DataContext="{Binding CardBuilderVM}"/>
                </TabItem>

                <!-- Tab 1: Bulk Audit & Fix -->
                <TabItem>
                    <views:BulkAuditView DataContext="{Binding BulkAuditVM}"/>
                </TabItem>

                <!-- Tab 2: Matrix Manager -->
                <TabItem>
                    <views:MatrixManagerView DataContext="{Binding MatrixManagerVM}"/>
                </TabItem>

                <!-- Tab 3: Settings -->
                <TabItem>
                    <views:SettingsView DataContext="{Binding SettingsVM}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
