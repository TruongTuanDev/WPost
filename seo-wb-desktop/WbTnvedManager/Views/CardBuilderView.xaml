<UserControl x:Class="WbTnvedManager.Views.CardBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Stepper Top Bar (12 Steps) -->
            <RowDefinition Height="Auto"/>
            <!-- Active Step Content Panel -->
            <RowDefinition Height="*"/>
            <!-- Bottom Navigation Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stepper Top Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Quy Trình 12 Bước Tạo &amp; Kiểm Tra Sản Phẩm Mới (Wildberries RU)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                
                <!-- Step Buttons / Indicator -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="1" Content="1. Ngữ cảnh" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="2" Content="2. Hàng thật" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="3" Content="3. Ma trận size" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="4" Content="4. ТН ВЭД" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="5" Content="5. GTIN GS1" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="6" Content="6. Hồ sơ NK" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="7" Content="7. Chứng từ РД" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="8" Content="8. Soạn bài WB" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="9" Content="9. Preflight" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="Bold" BorderThickness="0" Background="#FEE2E2" Foreground="#DC2626"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="10" Content="10. Đăng WB" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="11" Content="11. Media" Margin="0,0,4,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                        <Button Command="{Binding GoToStepCommand}" CommandParameter="12" Content="12. Marking" Margin="0,0,0,0" Padding="8,4" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Background="#EFF6FF" Foreground="#1D4ED8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Step Content Panels -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- STEP 1 & 2: Context & Real Product Specs -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={x:Null}}">
                        <TextBlock Text="Bước 1 &amp; 2: Ngữ Cảnh Kinh Doanh &amp; Mô Tả Hàng Thật" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Thị trường mục tiêu:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding TargetMarket}" Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="Vai trò người bán:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding BusinessRole}" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Nguồn gốc hàng:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding SupplySource}" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Mã hàng người bán (VendorCode / Артикул продавца):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,6,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding VendorCode, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Command="{Binding GenerateNewVendorCodeCommand}" Content="Sinh Mã Mới" Padding="12,0" Margin="6,0,0,0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Danh mục WB (Предмет):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" DisplayMemberPath="SubjectName" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="Giới tính (Пол):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Kết cấu dệt:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <ComboBox ItemsSource="{Binding KnitTypes}" SelectedItem="{Binding SelectedKnitType}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Thành phần đa lớp độc lập (Multi-layer Composition):" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Vải chính (Outer - 100%):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding OuterFabricComp, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="Lót trong (Lining - nếu có):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding LiningComp, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Ruột/Bông (Filling - nếu có):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding FillingComp, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CompositionValidationMessage}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- STEP 3 & 4: Variant Matrix & Classification -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ma Trận Biến Thể Size &amp; Mã Vạch (Variants Matrix):" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding AddDefaultSizesCommand}" Content="Khôi Phục S-XL" Padding="8,4" Margin="0,0,6,0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                    <Button Command="{Binding AddSizeCommand}" Content="➕ Thêm Size" Padding="8,4" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White" MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Size Quốc Tế" Binding="{Binding TechSize}" Width="100"/>
                                    <DataGridTextColumn Header="Size Nga (wbSize)" Binding="{Binding RussianSize}" Width="130"/>
                                    <DataGridTextColumn Header="Barcode / SKU (skus)" Binding="{Binding Sku}" Width="*"/>
                                    <DataGridTextColumn Header="Giá Bán (RUB)" Binding="{Binding Price}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Classification & TNVED Display -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Mã ТН ВЭД Đề Xuất (10 số):" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBox Text="{Binding TnvedCode, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Căn Cứ Phân Loại &amp; Quy Tắc:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding MatchReason}" FontSize="12" FontWeight="SemiBold" Foreground="#059669" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- STEP 8 & 9: Russian Content & Preflight Check -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nội Dung Tiếng Nga &amp; Kiểm Tra Preflight:" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <TextBlock Text="Tiêu đề chuẩn Nga (Наименование):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,0,2"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8"/>

                            <TextBlock Text="Mô tả chi tiết (Описание):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,0,2"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,0,0,8"/>

                            <!-- Preflight Score -->
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="10" Margin="0,4,0,8" BorderBrush="#BFDBFE" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding PreflightReadinessScore}" FontWeight="Bold" FontSize="13" Foreground="#1E40AF"/>
                                        <TextBlock Text="{Binding PreflightIssuesSummary}" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding RunPreflightCheckCommand}" Content="🔍 Chạy Lại Preflight" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,6" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Issue Items if any -->
                            <ItemsControl ItemsSource="{Binding PreflightIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⛔ "/>
                                                <TextBlock Text="{Binding RuleId}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Explanation}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding PrevStepCommand}" Content="⬅️ Bước Trước" Padding="14,8" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái: " FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding PublishStatus, FallbackValue='Sẵn sàng'}" FontWeight="SemiBold" Foreground="#2563EB"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding CopyPayloadCommand}" Content="📋 Sao Chép JSON" Padding="12,8" Margin="0,0,8,0" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Command="{Binding PublishDirectCommand}" Content="🚀 Đăng Lên Wildberries" Padding="18,8" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
