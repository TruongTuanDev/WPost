<UserControl x:Class="WbTnvedManager.Views.BulkAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WbTnvedManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:AuditStatusToBrushConverter x:Key="StatusBrushConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanConverter x:Key="InvBoolConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 Quét &amp; Đồng Bộ Sửa Lỗi TNVED / Giới Tính Hàng Loạt" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Tự động tải thẻ từ WB, đối chiếu ma trận, và sửa đồng loạt an toàn (bảo toàn 100% dữ liệu gốc: ảnh, kích thước, SKUs)." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Top Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadSampleCardsCommand}" Content="🧪 Nạp Thẻ Mẫu Thử Nghiệm" Background="#EEF2F6" Foreground="#2563EB" FontWeight="SemiBold" Padding="12,9" BorderBrush="#93C5FD" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Command="{Binding ScanCardsCommand}" Content="🔍 Quét Thẻ Từ WB" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,9" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Command="{Binding BulkFixCommand}" Content="⚡ Sửa Đồng Loạt Đã Chọn" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,9" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Command="{Binding CheckErrorsCommand}" Content="⚠️ Báo Cáo Lỗi WB" Background="#EEF2F6" Foreground="#334155" FontWeight="SemiBold" Padding="12,9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Command="{Binding CancelCommand}" Content="⛔ Dừng" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="12,9" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Bar & Filter Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Stats Badges -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="Tổng cộng: " Foreground="#64748B"/>
                        <Run Text="{Binding TotalCardsCount, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A"/>
                    </TextBlock>
                </Border>
                <Border Background="#DCFCE7" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="✅ Đạt chuẩn: " Foreground="#166534"/>
                        <Run Text="{Binding MatchedOkCount, Mode=OneWay}" FontWeight="Bold" Foreground="#166534"/>
                    </TextBlock>
                </Border>
                <Border Background="#FEE2E2" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="❌ Cần sửa: " Foreground="#991B1B"/>
                        <Run Text="{Binding NeedsFixCount, Mode=OneWay}" FontWeight="Bold" Foreground="#991B1B"/>
                    </TextBlock>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="Đã chọn sửa: " Foreground="#92400E"/>
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#92400E"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Search & Filter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lọc: " VerticalAlignment="Center" Foreground="#475569" Margin="0,0,4,0"/>
                <ComboBox SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Tag" Width="140" Height="30" Margin="0,0,10,0">
                    <ComboBoxItem Content="Tất cả sản phẩm" Tag="All"/>
                    <ComboBoxItem Content="⚠️ Cần sửa đổi" Tag="NeedsFix" IsSelected="True"/>
                    <ComboBoxItem Content="✅ Đã đạt chuẩn" Tag="MatchOk"/>
                    <ComboBoxItem Content="❓ Chưa có ma trận" Tag="NoMatrix"/>
                </ComboBox>

                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="6,0"/>
                <Button Command="{Binding SelectAllCommand}" Content="Chọn hết" Padding="8,4" Margin="0,0,4,0" Background="#F1F5F9" BorderBrush="#CBD5E1"/>
                <Button Command="{Binding DeselectAllCommand}" Content="Bỏ chọn" Padding="8,4" Background="#F1F5F9" BorderBrush="#CBD5E1"/>
            </StackPanel>
        </Grid>

        <!-- Main DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding FilteredResults}" SelectedItem="{Binding SelectedAuditItem}" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="38" AlternatingRowBackground="#F8FAFC" SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>

                    <!-- Status Column -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="130" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="4,0">
                                    <TextBlock Text="{Binding StatusBadge}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- VendorCode & NmID -->
                    <DataGridTextColumn Header="VendorCode / SKU" Binding="{Binding VendorCode, Mode=OneWay}" IsReadOnly="True" Width="130" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="NmID" Binding="{Binding NmId, Mode=OneWay}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Danh mục" Binding="{Binding SubjectName, Mode=OneWay}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="Tiêu đề sản phẩm" Binding="{Binding Title, Mode=OneWay}" IsReadOnly="True" Width="200"/>

                    <!-- Current TNVED vs Suggested TNVED -->
                    <DataGridTemplateColumn Header="TNVED Hiện Tại -> Chuẩn" Width="200" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentTnved}" Foreground="#EF4444" TextDecorations="Strikethrough" FontWeight="SemiBold"/>
                                    <TextBlock Text=" ➔ " Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SuggestedTnved}" Foreground="#16A34A" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Current Gender vs Suggested Gender -->
                    <DataGridTemplateColumn Header="Giới tính Hiện Tại -> Chuẩn" Width="180" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentGender}" Foreground="#94A3B8"/>
                                    <TextBlock Text=" ➔ " Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SuggestedGender}" Foreground="#2563EB" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Message / Reason -->
                    <DataGridTextColumn Header="Chi tiết / Lý do" Binding="{Binding StatusMessage, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detailed Inspection & Side-by-Side Reconciliation Drawer -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔎 ĐỐI CHIẾU 4 NGUỒN DỮ LIỆU &amp; BẰNG CHỨNG:" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedAuditItem.VendorCode, StringFormat='SKU: {0}'}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding SelectedAuditItem.Title}" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="📋 Nội dung: Đạt" Foreground="#3730A3" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="🏷️ GTIN: Đã đối soát" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="📜 Hồ sơ: Đã liên kết" Foreground="#92400E" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4 Columns Side-by-Side -->
                <Grid Background="#FFFFFF" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: WB Hiện Tại -->
                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="1. Dữ liệu WB Hiện Tại" FontWeight="Bold" Foreground="#EF4444" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedAuditItem.CurrentTnved, StringFormat='ТНВЭД: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAuditItem.CurrentGender, StringFormat='Пол (Giới tính): {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAuditItem.DetectedMaterial, StringFormat='Chất liệu: {0}'}" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Col 2: Hệ thống NK / GS1 -->
                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="2. Нац. каталог / GS1" FontWeight="Bold" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Trạng thái: Опубликована" FontSize="12"/>
                            <TextBlock Text="Định danh: GTIN-13 chuẩn" FontSize="12"/>
                            <TextBlock Text="Quyền sửa: Cổng GS1/NK" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Col 3: Hồ sơ Hợp quy & Nguồn gốc -->
                    <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="3. Chứng từ Hợp quy (РД)" FontWeight="Bold" Foreground="#2563EB" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Loại: Декларация (ДС)" FontSize="12"/>
                            <TextBlock Text="Quy chuẩn: ТР ТС 017/2011" FontSize="12"/>
                            <TextBlock Text="Phạm vi: Bao phủ model" FontSize="11" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>

                    <!-- Col 4: Đề xuất Chuẩn hóa -->
                    <Border Grid.Column="3" BorderBrush="#86EFAC" Background="#F0FDF4" BorderThickness="1" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="4. Đề xuất Sửa Chuẩn Hóa" FontWeight="Bold" Foreground="#16A34A" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedAuditItem.SuggestedTnved, StringFormat='ТНВЭД chuẩn: {0}'}" FontWeight="Bold" Foreground="#16A34A" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAuditItem.SuggestedGender, StringFormat='Пол chuẩn: {0}'}" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAuditItem.MatchReason}" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="150" Height="14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
